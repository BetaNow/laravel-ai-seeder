{
    "name": "betanow/laravel-ai-seeder",
    "description": "Seed Eloquent models with realistic data generated by an LLM (OpenAI or any OpenAI-compatible server)",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "seeder",
        "faker",
        "ai",
        "llm",
        "openai"
    ],
    "homepage": "https://github.com/BetaNow/laravel-ai-seeder",
    "support": {
        "issues": "https://github.com/BetaNow/laravel-ai-seeder/issues"
    },
    "authors": [
        {
            "name": "BetaNow",
            "email": "betanow.dev@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "BetaNow\\AiSeeder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BetaNow\\AiSeeder\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "fakerphp/faker": "^1.23"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0|^13.0",
        "laravel/pint": "^1.13",
        "symfony/process": "^7.2|^8.0"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Vendor\\AiSeeder\\AiSeederServiceProvider"
            ],
            "aliases": {
                "AiSeeder": "Vendor\\AiSeeder\\Facades\\AiSeeder"
            }
        }
    }
}
